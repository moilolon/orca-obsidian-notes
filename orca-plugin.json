{
  "manifestVersion": 2,
  "id": "notes",
  "name": "Obsidian Notes",
  "version": "0.2.0",
  "description": "Read the notes of an Obsidian vault in Orca's sidebar: folder tree, search, callouts and [[links]], with the open note filling the panel.",
  "repository": "https://github.com/moilolon/orca-obsidian-notes",
  "author": {
    "name": "moilolon"
  },
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "The plugin name beside a sidebar panel showing a note whose sections open on colored bands"
  },
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "notes",
        "title": "Obsidian",
        "icon": "book",
        "entry": "src/panel/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ]
}
